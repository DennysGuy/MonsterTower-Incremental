[resource]
script = ExtResource("2_qsoro")
quest_title = "The True Nature of the Tower 1"
quest_id = 5
quest_type = 1
level_needed = 5
description = "Biologist Marquise
[color=green]Slay 50 Goblin Thiefs, 50 Purple Mimics, 50 Pink Bats, 50 Shrubs[/color]

\"Through all my years of studying the biology of Natural entities, I have not seen anything like this. Logically, it makes sense. The Tower seemingly appeared out of no where with properties unknown to man. But still, my brain has issues accepting what is true.

This Tower, like most, I am extremely fascinated with it. The appearance of the tower is an enigma - but it's true nature, it eludes me. The people seem to look at it without question. Sure, they comment on its bizarre nature, but that is where the questioning stops. 

I am curious with what we are truly dealing with, and I think the answer starts with studying the biology of the monsters within the tower.. It feels like a tragedy to only treat the tower as a commodity - for profit. 

What is truly there..  

Please, help me uncover this mystery.\""
turn_in_description = "Biologist Marquise

\"I see, thank you for your assistance. My team will bring these component to lab for us to run experiments.. These creatures.. what are they? What is the tower? They are made of nothing Humanity has ever seen before..

Please standby for the next request. We will uncover this mystery one request at a time.\""
chapter_relation = "Introduction"
quest_line = "The True Nature of the Tower"
tasks = Array[ExtResource("3_3mdpa")]([ExtResource("7_k18ed"), ExtResource("8_u3h7r"), ExtResource("9_ud7nj"), ExtResource("10_3cwon")])
