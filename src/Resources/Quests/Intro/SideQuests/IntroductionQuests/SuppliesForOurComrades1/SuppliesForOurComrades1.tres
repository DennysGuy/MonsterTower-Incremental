[resource]
script = ExtResource("3_7sppe")
quest_title = "Supplies For Our Comrades 1"
quest_id = 4
quest_type = 1
level_needed = 5
description = "Weapons Tech Engineer Crop Duster

[color=green](gather 5 Beetle Claws, Slay 35 Red Beetles and 25 Blue Beetles)[/color]

\"Hey Duster here, 

The Hunters Committee has contracted me to help maintain the stock pile of hunter weapons. They say we're running low as more and more of our stock pile disappears within the tower along with slain hunters. 

I'm looking for those willing to lend a helping hand and deliver some base resources to get our aresenal going again. 

Oh yeah, this job is a bit of a duezy. Don't worry, the Committee will compensate you well for your efforts.

Thanks in advance.\""
turn_in_description = "Weapons Tech Engineer Crop Duster

\"This will do. Don't worry about crafting the resources, I'll take care of that. Just keep your nose to the grindstone and get up that tower.

I'll issue your next assignment shortly.

Thanks again.\""
chapter_relation = "Introduction"
quest_line = "Gearing up for the Raid"
