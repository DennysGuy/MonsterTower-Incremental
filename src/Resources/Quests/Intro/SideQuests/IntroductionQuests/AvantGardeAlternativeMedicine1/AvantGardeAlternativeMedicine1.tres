[resource]
script = ExtResource("2_q7fhk")
quest_title = "Avant Garde Alt. Medicine 1"
quest_id = 6
quest_type = 1
level_needed = 5
description = "Doctor Tharki
(Gather 20 Mushie Core, 15 Beetle Shells, 10 Serpant Tongue)

\"Hi, I'm Doctor Tharki. 

I have been a man of conventional medicine my whole life; however, people do not realize that I am also highly interested in alternative pursuits. 

I am here on behalf of the Hunter's Committee to help research new Medicine to help aid the Hunter's on their expedition. Longevity is the game when you're in the tower.
It is dangerous, especially going in alone. 

The current medicine provided from the hunter's commitee has been deemed inefficient. I will change that. My alternative medicine pursuits are actually what I believe will be of effect here. 

The truth is that the Tower has taken what we understand as conventional science and flipped it upside on its head. Our past methods seem to fail at every turn and we are scrambling for a solution. 

This is where I believe my alternative pursuits. Unconventional ways may be the path forward. We can only see. 

Help me with gathering drops from the tower and together we will change the world of Medicine - and to an extent - science, once and for all.\""
turn_in_description = "Doctor Tharki

\"I see now. Things are even more confusing than before. My team has taken the findings to the laboratory and we will begin trials to see what we can find.

Wish us luck. Humanity needs this as much as I do.\""
chapter_relation = "Introduction"
quest_line = "Cutting Edge Medicine"
tasks = Array[ExtResource("3_25glh")]([ExtResource("5_m4eb2"), ExtResource("6_gemyw"), ExtResource("7_n4n72")])
currency_reward = 3000
xp_reward = 800
