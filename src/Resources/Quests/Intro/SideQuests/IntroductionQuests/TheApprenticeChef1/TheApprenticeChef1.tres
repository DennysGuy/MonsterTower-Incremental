[resource]
script = ExtResource("2_tsf1b")
quest_title = "The Apprentice Chef 1"
quest_id = 3
quest_type = 1
level_needed = 5
description = "Master Chef Cook Nadene

(Gather 10 Fried Gagootz and 10 Mossy Goulash)

\"Wowwyyy.. out of all my years as a Master Chef Cook I've never dreamed of the mystical ingredients supplied
by that Tower. 

The Average person might only see novelty, but us cooks see a playground for endless possibilities.

The Hunter's Committee hired me to oversee the rationing department, but I'm curious with what the human imagination could conjure with ingredients extracted straight from the Monsters.

I am busy with solving this major rationing problem for the committee, so I am looking for an assistant to help me with this passion project. 

The first person to bring me 10 cooked Gagootz and 10 Mossy Goulash will have proven to me that they are worthy of becoming my apprentice!\""
turn_in_description = "Master Chef Cook Nadene

\"Well look at you, consider me impressed. Your resourcefulness and cooking skill has officially convinced me that you will be a powerful asset for my dream .

We're not going to just make a fortune, but we are on the cusp of revolutionizing an entire Industry!

Keep some of your turn in, it might help you get a bit further up the Tower.\""
chapter_relation = "Introduction"
quest_line = "Inovating the Cooking Industry"
tasks = Array[ExtResource("3_j7deo")]([ExtResource("4_j7deo"), ExtResource("5_yupbl")])
currency_reward = 1200
xp_reward = 500
item_reward = Dictionary[ExtResource("1_lhq2l"), int]({
