[sub_resource type="Animation" id="Animation_kj54n"]
resource_name = "text3"
length = 7.0
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("TitleText:text")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": ["Before long, it was discovered that the [color=gray]STRUCTURE[/color]
was in truth a [color=purple]TOWER[/color], 

though months passed before anyone dared to step inside.

And when at last one did,
it was revealed that strange, mystical [color=green]MONSTERS[/color]
inhabited its floors."]
}
