tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": ["The [color=gray]TOWER[/color] soon proved to be [color=red]DANGEROUS[/color].

Many who ventured within,
seeking to claim its treasures,
fell victim to the [color=green]MONSTERS[/color] that lurked inside.

Yet those who returned alive
returned with [color=yellow]FORTUNES[/color] beyond imagining.
"]
}
