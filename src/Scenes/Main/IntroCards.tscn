[sub_resource type="Animation" id="Animation_ud5h8"]
resource_name = "text2"
length = 6.0
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("TitleText:text")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": ["Naturally, the PEOPLE were drawn to the [color=gray]STRUCTURE[/color],
puzzled by its [color=brown]EERIE[/color], [color=gray]MONOLITHIC[/color] presence.

Before long, it was hailed as the seventh wonder of the world,
and travelers from distant lands journeyed to behold it.

A town soon rose in its shadow,
and it was named [color=yellow]STARSPIRE[/color]."]
}
tracks/1/type = "value"
tracks/1/imported = false
tracks/1/enabled = true
